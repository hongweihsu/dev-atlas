POSTGRES_DB=retrieval_works
POSTGRES_USER=retrieval_works
POSTGRES_PASSWORD=retrieval_works
DATABASE_URL=postgresql+asyncpg://retrieval_works:retrieval_works@postgres:5432/retrieval_works
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Local Docker Compose only. Use a secrets system and external identity provider
# for deployed environments.
AUTH_JWT_SECRET=retrieval-works-local-development-secret-change-me
AUTH_DEVELOPMENT_MODE=true
# Use a separate long random secret for Prometheus or an operator checking /metrics.
OBSERVABILITY_METRICS_TOKEN=change-me-to-a-long-random-token
# Production alternative: leave AUTH_JWT_SECRET empty, disable development mode,
# and configure the provider's HTTPS JWKS endpoint plus issuer/audience.
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://identity.example.com/
# AUTH_JWT_AUDIENCE=retrieval-works-api
VITE_API_BASE_URL=/api
