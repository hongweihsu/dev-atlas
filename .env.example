POSTGRES_DB=devatlas
POSTGRES_USER=devatlas
POSTGRES_PASSWORD=devatlas
DATABASE_URL=postgresql+asyncpg://devatlas:devatlas@postgres:5432/devatlas
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
# Local Docker Compose only. Use a secrets system and external identity provider
# for deployed environments.
AUTH_JWT_SECRET=devatlas-local-development-secret-change-me
AUTH_DEVELOPMENT_MODE=true
# Production alternative: leave AUTH_JWT_SECRET empty, disable development mode,
# and configure the provider's HTTPS JWKS endpoint plus issuer/audience.
# AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# AUTH_JWT_ISSUER=https://identity.example.com/
# AUTH_JWT_AUDIENCE=devatlas-api
VITE_API_BASE_URL=/api
