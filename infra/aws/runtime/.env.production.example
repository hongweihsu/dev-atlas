POSTGRES_DB=retrieval_works
POSTGRES_USER=retrieval_works
POSTGRES_PASSWORD=replace-through-ssm
DATABASE_URL=postgresql+asyncpg://retrieval_works:replace-through-ssm@postgres:5432/retrieval_works
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=replace-through-ssm
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
ANSWER_MODEL=gpt-4.1-mini
AUTH_DEVELOPMENT_MODE=false
AUTH_JWT_SECRET=
AUTH_JWKS_URL=https://cognito-idp.ap-southeast-2.amazonaws.com/replace-user-pool-id/.well-known/jwks.json
AUTH_JWT_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/replace-user-pool-id
AUTH_JWT_AUDIENCE=replace-app-client-id
AUTH_COGNITO_CLIENT_ID=replace-app-client-id
OBSERVABILITY_METRICS_TOKEN=replace-through-ssm
BACKUP_BUCKET=replace-from-terraform-output
